export DOTFILES=$HOME/.dotfiles
export ZSH=$DOTFILES/zsh

# Keep 1000 lines of history within the shell and save it to ~/.zsh_history:
HISTSIZE=1000
SAVEHIST=1000
HISTFILE=~/.zsh_history

##
#Set Options for ZSH
setopt CORRECT

unsetopt beep

autoload -U compinit
autoload -U compinit && compinit
autoload colors zsh/terminfo

zmodload zsh/terminfo

if [[ `uname` == 'Darwin' ]]; then
  bindkey '^[[A' history-substring-search-up
  bindkey '^[[B' history-substring-search-down
else
  bindkey "$terminfo[kcuu1]" history-substring-search-up
  bindkey "$terminfo[kcud1]" history-substring-search-down
fi

export JAVA_HOME=/usr/lib/jvm/zulu21/
export PATH=$JAVA_HOME/bin:$PATH
# export PATH=/opt/go/bin:$PATH
export PATH=/usr/local/go/bin:$PATH
export GOPATH=$HOME/.golang
export GOBIN=$GOPATH/bin
export PATH=$PATH:$GOBIN

export PATH=$PATH:$HOME/.zig/

export PATH=$PATH:$HOME/.anaconda3/bin/

export LD_LIBRARY_PATH=/usr/lib/cuda/lib64:$LD_LIBRARY_PATH
export LD_LIBRARY_PATH=/usr/lib/cuda/include:$LD_LIBRARY_PATH

export HELIX_DEFAULT_RUNTIME=~/.config/helix/runtime

export PATH=~/.npm-global/bin:$PATH

alias cgrep='grep -rin --colour=auto' 
alias ll='ls' 
alias ls='ls -lah' 
alias pros='ps aux | grep' 
alias lock='i3lock -c 111111 -n'
alias tmux='tmux -2'

git config \
  --global \
  url."https://emculber:glpat-YJ5cfXoWkUushL21gbW1@gitlab.com".insteadOf \
  "https://gitlab.com"

# source all .zsh files inside of the zsh/ directory
for config ($ZSH/**/*.zsh) source $config

[ -f ~/.fzf.zsh ] && source ~/.fzf.zsh

export PATH="$PATH:/opt/nvim-linux64/bin"
alias vim=nvim

